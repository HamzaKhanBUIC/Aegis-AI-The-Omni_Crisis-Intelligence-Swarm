# Copy to .env and fill in. Every value here is server-side only: never put
# these in a Flutter/web build. (The Firebase web config in firebase_options.dart
# is public by design; Firestore rules are what protect the data.)

# Hugging Face Inference Token (For Llama-3-70B or other LLMs)
HF_API_TOKEN=

# Firebase Admin SDK Path (Real-time Sync). The JSON key file is git-ignored.
FIREBASE_CREDENTIALS_PATH="./config/serviceAccountKey.json"

# Swarm Execution Mode (True for Live LLM, False for Mock Fallback)
USE_LIVE_AI="True"

# Shared secret for POST /api/v1/sentinel/submit (sent as the X-API-Key header).
# Required, at least 32 chars; the endpoint returns 503 while it is unset.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AEGIS_INGEST_API_KEY=

# Comma-separated browser origins allowed by CORS, e.g. https://aegis-ai-omni.web.app
# Empty = no cross-origin access. "*" is rejected.
ALLOWED_ORIGINS=

# Ingest rate limit per client IP (in-memory, per process)
INGEST_RATE_LIMIT=10
INGEST_RATE_WINDOW_SECONDS=60

# Max swarm runs per minute started by the Firestore listener
SWARM_LISTENER_MAX_PER_MINUTE=30

# Max request body size in bytes
MAX_REQUEST_BYTES=16384

# Bind address/port for `python src/main_api.py` (use HOST=0.0.0.0 in a container)
HOST=127.0.0.1
PORT=8000
